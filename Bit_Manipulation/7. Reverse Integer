class Solution(object):
    def reverse(self, x):
        sign = -1 if x < 0 else 1
        x = abs(x)
        ans = 0

        while x:
            n = x % 10
            x //= 10
            ans = ans * 10 + n

        ans *= sign

        if ans < -2**31 or ans > 2**31 - 1:
            return 0

        return ans
